# Webhook Security
WEBHOOK_PASSPHRASE=tu_passphrase_secreta_aqui

# Binance Futures API Credentials
BINANCE_API_KEY=tu_binance_api_key
BINANCE_SECRET_KEY=tu_binance_secret_key

# Trading Environment (True for Testnet, False for Mainnet Production)
BINANCE_TESTNET=True

# Default Trading & Risk Settings
DEFAULT_LEVERAGE=5
MARGIN_MODE=ISOLATED
RISK_PERCENT=2.0
STOP_LOSS_PERCENT=1.5
TAKE_PROFIT_PERCENT=3.0

# Telegram Notifications
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token
TELEGRAM_CHAT_ID=tu_telegram_chat_id

# Server Settings
LOG_LEVEL=INFO
