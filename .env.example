# Webhook Security
WEBHOOK_PASSPHRASE=tu_passphrase_secreta_aqui

# Multi-Exchange Configuration (bybit, binance, okx, bitget, kucoinfutures)
EXCHANGE=bybit
EXCHANGE_API_KEY=tu_exchange_api_key
EXCHANGE_SECRET_KEY=tu_exchange_secret_key
EXCHANGE_PASSWORD=  # Solo necesario si tu exchange requiere contraseña/passphrase de API (ej: OKX, Kucoin)
EXCHANGE_TESTNET=True

# Legacy Binance Credentials (Fallback si EXCHANGE_API_KEY no está configurado)
BINANCE_API_KEY=tu_binance_api_key
BINANCE_SECRET_KEY=tu_binance_secret_key
BINANCE_TESTNET=True

# Default Trading & Risk Settings
DEFAULT_LEVERAGE=5
MARGIN_MODE=ISOLATED
RISK_PERCENT=2.0
STOP_LOSS_PERCENT=1.5
TAKE_PROFIT_PERCENT=3.0

# Telegram Notifications
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token
TELEGRAM_CHAT_ID=tu_telegram_chat_id

# Server Settings
LOG_LEVEL=INFO

